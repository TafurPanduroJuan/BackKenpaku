# Application
PROJECT_NAME="Comercial Kenpaku S.A.C. API"
ENV="development"
PORT=8000

# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres"

# Gemini API (Google AI Studio)
GEMINI_API_KEY="apikey"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Tipo de cambio USD/PEN: adaptador HTTP JSON configurable
FX_API_URL=""
FX_API_KEY=""

# Auth / JWT Security
JWT_SECRET="cambia-esto-por-un-valor-generado-de-48-caracteres-o-mas"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://kenpaku.vercel.app"

# Business & RAG Settings
WHATSAPP_NUMBER="51987654321"
STOCK_LOW_THRESHOLD=10
RAG_MAX_DISTANCE=0.5
OFFTOPIC_MIN_DISTANCE=0.75

# Admin Seed Account
ADMIN_EMAIL="admin@kenpaku.pe"
ADMIN_PASSWORD="cambia-esto-por-una-contraseña-propia-de-12-o-mas-caracteres"

# Cajero (opcional; sin CAJERO_PASSWORD el seed no crea ni toca al cajero)
CAJERO_EMAIL="cajero@kenpaku.pe"
CAJERO_PASSWORD=""

# Notificaciones (Fase 3: Brevo y Telegram)
BREVO_API_KEY=""
SENDER_EMAIL="ventas@kenpaku.pe"
SENDER_NAME="Comercial Kenpaku S.A.C."
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Vouchers Storage (Fase 4: Supabase Storage)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET_VOUCHERS="vouchers"
SUPABASE_BUCKET_PRODUCTS="products"

# Automatizaciones y Cron (Fase 5)
CRON_SECRET="cambia-esto-por-un-valor-generado-de-24-caracteres-o-mas"
