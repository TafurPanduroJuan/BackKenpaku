# Application
PROJECT_NAME="Comercial Kenpaku S.A.C. API"
ENV="development"
PORT=8000

# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres"

# OpenAI API
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Auth / JWT Security
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://kenpaku.vercel.app"

# Business & RAG Settings
WHATSAPP_NUMBER="51987654321"
STOCK_LOW_THRESHOLD=10
RAG_MAX_DISTANCE=0.5

# Admin Seed Account
ADMIN_EMAIL="admin@kenpaku.pe"
ADMIN_PASSWORD="AdminKenpaku2026!"
